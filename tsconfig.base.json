{
  "compileOnSave": false,
  "compilerOptions": {
    "rootDir": ".",
    "sourceMap": true,
    "declaration": false,
    "moduleResolution": "bundler",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "es2015",
    "module": "esnext",
    "lib": ["es2020", "dom"],
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "strict": false,
    "paths": {
      "login/Routes": ["./apps/login/src/app/remote-entry/entry.routes.ts"],
      "dashboard/Routes": [
        "./apps/dashboard/src/app/remote-entry/entry.routes.ts"
      ],
      "data-access-user": ["./libs/shared/data-access-user/src/index.ts"]
    }
  },
  "exclude": ["node_modules", "tmp"]
}
